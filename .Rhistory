#1. Read & clean
df <- read_csv(
"C:/Users/pw174/Documents/Systematic_Paper/150_Paper_Region.csv",
show_col_types = FALSE
)
df_clean <- df %>%
filter(
!is.na(Decision_representation_type),
!is.na(Region),
Decision_representation_type != "",
Region != "")
#2. Count connections
sum_df <- df_clean %>%
count(Decision_representation_type, Region, name = "n")
#3. Totals
left_totals <- sum_df %>%
group_by(Decision_representation_type) %>%
summarise(total = sum(n), .groups = "drop") %>%
arrange(desc(total))
right_totals <- sum_df %>%
group_by(Region) %>%
summarise(total = sum(n), .groups = "drop") %>%
arrange(desc(total))
#4. Labels with wrapping
make_label <- function(x, total, width = 35) {
paste0(str_wrap(x, width = width), " (n=", total, ")")
}
left_labels <- setNames(
make_label(left_totals$Decision_representation_type, left_totals$total),
left_totals$Decision_representation_type
)
right_labels <- setNames(
make_label(right_totals$Region, right_totals$total),
right_totals$Region
)
#5. Apply factor ordering
sum_df$Decision_representation_type <- factor(
sum_df$Decision_representation_type,
levels = left_totals$Decision_representation_type,
labels = left_labels
)
sum_df$Region <- factor(
sum_df$Region,
levels = right_totals$Region,
labels = right_labels
)
#6. Padding to avoid tiny strata (same trick as your journal plot)
MIN_HEIGHT_LEFT <- 10
MIN_HEIGHT_RIGHT <- 14
left_pad <- sum_df %>%
group_by(Decision_representation_type) %>%
summarise(true_total = sum(n), .groups = "drop") %>%
mutate(padded_total = pmax(true_total, MIN_HEIGHT_LEFT))
right_pad <- sum_df %>%
group_by(Region) %>%
summarise(true_total = sum(n), .groups = "drop") %>%
mutate(padded_total = pmax(true_total, MIN_HEIGHT_RIGHT))
sum_df <- sum_df %>%
left_join(
left_pad %>% select(Decision_representation_type,
l_true = true_total, l_pad = padded_total),
by = "Decision_representation_type"
) %>%
left_join(
right_pad %>% select(Region,
r_true = true_total, r_pad = padded_total),
by = "Region"
) %>%
mutate(
n_l = n * (l_pad / l_true),
n_r = n * (r_pad / r_true),
y = (n_l + n_r) / 2
)
#7. Plot
p3 <- ggplot(
sum_df,
aes(
axis1 = Decision_representation_type,
axis2 = Region,
y = y
)
) +
geom_alluvium(
aes(fill = n, alpha = n, linewidth = n),
width = 0.22,
color = "grey40"
) +
geom_stratum(
width = 0.45,
fill = "grey90",
color = "grey40"
) +
geom_text(
stat = "stratum",
aes(label = after_stat(stratum)),
size = 3.5,
lineheight = 1.05
) +
scale_fill_viridis(
option = "viridis",
name = "Connection strength",
guide = guide_colorbar(barheight = 10)
) +
scale_alpha(range = c(0.4, 0.9), guide = "none") +
scale_linewidth(range = c(0.4, 1.8), guide = "none") +
scale_x_discrete(
limits = c("Decision representation type", "Study region"),
expand = c(.12, .05)
) +
scale_y_continuous(
expand = expansion(mult = c(0.02, 0.08))
) +
labs(
x = NULL,
y = "Number of papers"
) +
theme_minimal(base_size = 18) +
theme(
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank(),
axis.text.y = element_blank(),
axis.ticks = element_blank(),
axis.text.x = element_text(face = "bold", size = 18),
legend.position = "right"
)
plot(p3)
library(dplyr)
library(lubridate)
library(ggplot2)
library(readr)
###############################################################################
# User-defined constants (Falls Lake example or any lake)
###############################################################################
# Conservation operation constants for Falls Lake Dam
Smin <- 0.5 # Minimum storage in MCM
Smax <- 200.12 # Maximum storage in MCM
min_release <- 0.57 # Minimum release (m^3/s)
max_release <-550 # Maximum release (m^3/s)
csv_file <- "C:/Users/pw174/Documents/Dam_Information/AGU_Data/New_para_Data/Falls_Lake_OT_Test.csv"
df <- read_csv(csv_file,
col_types = cols(
Date = col_date(format = "%m/%d/%Y"),
Storage = col_double(),
Elevation = col_double()
))
##
# Example file with daily outflow values
inflow_file <- "C:/Users/pw174/Documents/Dam_Information/USGS_Mother/Discharge_contribution.csv"
inflows <- read_csv(inflow_file,
col_types = cols(
Date = col_date(format = "%m/%d/%Y"),
inflow = col_double()
)) %>%
mutate(Month = month(Date))
monthly_avg <- inflows %>%
mutate(Month = month(Date)) %>%
filter(!is.na(Month), !is.na(inflow)) %>%    # remove bad rows
group_by(Month) %>%
summarise(AvgInflow = mean(inflow, na.rm = TRUE)) %>%
ungroup()
total_inflow <- sum(monthly_avg$AvgInflow, na.rm = TRUE)
monthly_avg <- monthly_avg %>%
mutate(Percentage = (AvgInflow / total_inflow) * 100) %>%
arrange(Month)
print(monthly_avg)
month_names <- month.abb
discharge_profile <- setNames(monthly_avg$Percentage, month_names)
# Normalize so average weight ~1.0
discharge_profile <- discharge_profile / mean(discharge_profile)
